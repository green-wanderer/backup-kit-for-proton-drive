#!/usr/bin/env bash
# pd-send - send files to a Proton Drive folder, or get files from one.
#
# Usage: pd-send --to FOLDER FILE...            upload, then confirm each file arrived
#        pd-send --pick FILE...                 choose the folder from your Drive tree
#        pd-send --mkdir [--to PARENT] FILE...  make a new folder, then send into it
#        pd-send --get [PATH...]                browse Drive, download next to PATH
#        pd-send --refresh                      re-read the folder tree (pd-send-menu)
#
# The Dolphin menu calls these. Started from a terminal it prompts there;
# otherwise it uses kdialog and desktop notifications. send_conflict decides
# what happens when a file with the same name is already on Drive.

PROG=pd-send
[[ $1 == -h || $1 == --help ]] && { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0; }
HERE=$(dirname "$(readlink -f "$0")")
source "$HERE/../lib/common.sh"

MODEL="$CACHE_DIR/menu.tsv"
MODE="" DEST=""
while [[ $1 == --* ]]; do
    case $1 in
        --to)      [[ -n $2 ]] || die "--to needs a folder"; DEST=${2%/}; shift 2 ;;
        --pick|--mkdir|--get|--refresh) MODE=${MODE:-${1#--}}; shift ;;
        --) shift; break ;;
        *) die "unknown option $1 (try -h)" ;;
    esac
done
[[ -n $MODE ]] || MODE=send
[[ $MODE == send && -z $DEST ]] && die "say where: --to FOLDER, or --pick"

GUI=0
[[ ! -t 0 ]] && command -v kdialog >/dev/null && GUI=1

# --- prompts -----------------------------------------------------------------

ui_error() {
    if (( GUI )); then kdialog --title "Proton Drive" --error "$1" >/dev/null 2>&1; else warn "$1"; fi
}

# ui_menu PROMPT TAG LABEL [TAG LABEL...] -> the chosen tag; 1 if cancelled
ui_menu() {
    local prompt=$1 i n; shift
    if (( GUI )); then
        kdialog --title "Proton Drive" --menu "$prompt" "$@" 2>/dev/null
        return
    fi
    local -a tags=()
    printf '\n%s\n' "$prompt" >&2
    for (( i = 1; i <= $#; i += 2 )); do
        tags+=("${!i}"); n=$((i + 1))
        printf '%3d) %s\n' "${#tags[@]}" "${!n}" >&2
    done
    read -rp "Choose [1-${#tags[@]}]: " n </dev/tty || return 1
    [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#tags[@]} )) || return 1
    printf '%s\n' "${tags[n - 1]}"
}

ui_input() { # PROMPT DEFAULT -> text; 1 if cancelled
    local r
    if (( GUI )); then
        kdialog --title "Proton Drive" --inputbox "$1" "$2" 2>/dev/null
        return
    fi
    read -rp "$1 " -e -i "$2" r </dev/tty || return 1
    printf '%s\n' "$r"
}

# --- the cached folder tree --------------------------------------------------

ensure_model() { [[ -s $MODEL ]] || "$HERE/pd-send-menu" --quiet; }

children() { # PATH -> child paths, sorted by name
    P=$1 awk -F'\t' '$1 == "N" && $3 == ENVIRON["P"] { print $4 "\t" $2 }' "$MODEL" 2>/dev/null |
        sort -f | cut -f2
}

pick_folder() { # [PROMPT] -> DEST; exits quietly on cancel
    local cur=$DRIVE_ROOT choice c label
    ensure_model
    while :; do
        local -a args=(__here__ "Send here: $cur")
        [[ $MODE == mkdir ]] && args=(__here__ "Make the new folder in: $cur")
        while IFS= read -r c; do
            [[ -n $c ]] || continue
            label=${c##*/}
            [[ -n $(children "$c") ]] && label+="  ▸"
            args+=("$c" "$label")
        done < <(children "$cur")
        [[ $cur != "$DRIVE_ROOT" ]] && args+=(__up__ "◂ Up")
        [[ $MODE != mkdir ]] && args+=(__mkdir__ "New folder here…")
        args+=(__type__ "Type a path…" __refresh__ "Refresh folder list")

        choice=$(ui_menu "${1:-Send ${#FILES[@]} item(s) to:}" "${args[@]}") || exit 0
        case $choice in
            __here__)    DEST=$cur; return ;;
            __up__)      cur=${cur%/*} ;;
            __mkdir__)   make_folder "$cur" && { DEST=$NEW; return; } ;;
            __refresh__) "$HERE/pd-send-menu" --quiet || ui_error "Could not re-read the folder list." ;;
            __type__)    DEST=$(ui_input "Drive folder:" "$cur/") || exit 0
                         DEST=${DEST%/}; [[ $DEST == /* ]] && return ;;
            *)           if [[ -n $(children "$choice") ]]; then cur=$choice; else DEST=$choice; return; fi ;;
        esac
    done
}

make_folder() { # PARENT -> NEW; 1 on failure or cancel
    local name
    name=$(ui_input "New folder in $1:" "") || return 1
    name=${name#"${name%%[![:space:]]*}"}; name=${name%"${name##*[![:space:]]}"}
    [[ -n $name && $name != */* ]] || { ui_error "A folder name cannot be empty or contain /."; return 1; }
    timeout "$CALL_TIMEOUT" proton-drive filesystem create-folder "$1" "$name" </dev/null >/dev/null 2>&1
    drive_ls "$1" | cut -f1,3 | grep -qxF "folder"$'\t'"$name" ||
        { ui_error "Could not create $1/$name."; return 1; }
    NEW="$1/$name"
    [[ -s $MODEL ]] && printf 'N\t%s\t%s\t%s\n' "$NEW" "$1" "$name" >>"$MODEL"
    return 0
}

# --- send --------------------------------------------------------------------

send() {
    local listing f n remote ok=0 rc=0
    local -a problems=()
    say "Sending ${#FILES[@]} item(s) to $DEST"
    timeout "$SEND_TIMEOUT" proton-drive filesystem upload -f "$SEND_CONFLICT" -d merge "${FILES[@]}" "$DEST" \
        </dev/null >/dev/null 2>&1 || rc=$?
    listing=$(drive_ls "$DEST")
    entry() { T=$1 N=$2 awk -F'\t' '$1 == ENVIRON["T"] && $3 == ENVIRON["N"] { print $2; f = 1 } END { exit !f }' <<<"$listing"; }
    for f in "${FILES[@]}"; do
        n=${f%/}; n=${n##*/}
        if [[ -d $f ]]; then
            entry folder "$n" >/dev/null && ok=$((ok + 1)) || problems+=("$n: folder not found on Drive")
        elif ! remote=$(entry file "$n"); then
            problems+=("$n: not on Drive")
        elif [[ $remote != "$(stat -c %s "$f")" ]]; then
            problems+=("$n: a different file with that name is already there")
        else
            ok=$((ok + 1))
        fi
    done
    if (( ${#problems[@]} )); then
        printf '  %s\n' "${problems[@]}"
        notify critical "Sent $ok of ${#FILES[@]} to Proton Drive" "$(printf '%s\n' "${problems[@]}")"
        exit 1
    fi
    say "  all $ok confirmed on Drive (upload rc=$rc)"
    notify normal "Sent to Proton Drive" "$ok item(s) to ${DEST#"$DRIVE_ROOT"}/"
    exit 0
}

# --- get ---------------------------------------------------------------------

get() {
    local into cur=$DRIVE_ROOT choice type size name listing
    into=${1:-$PWD}
    [[ -d $into ]] || into=$(dirname "$into")
    while :; do
        listing=$(drive_ls "$cur") || { ui_error "Could not list $cur."; exit 1; }
        local -a args=()
        [[ $cur != "$DRIVE_ROOT" ]] && args+=(__up__ "◂ Up")
        while IFS=$'\t' read -r type size name; do
            [[ $type == folder ]] && args+=("d:$name" "$name/")
        done <<<"$listing"
        while IFS=$'\t' read -r type size name; do
            [[ $type == file ]] && args+=("f:$name" "$name  ($(numfmt --to=iec "$size" 2>/dev/null || echo "$size"))")
        done <<<"$listing"
        [[ $cur != "$DRIVE_ROOT" ]] && args+=(__all__ "Download this whole folder")
        (( ${#args[@]} )) || { ui_error "$cur is empty."; exit 0; }

        choice=$(ui_menu "$cur  (saving to $into)" "${args[@]}") || exit 0
        case $choice in
            __up__)  cur=${cur%/*} ;;
            __all__) download "$cur" "$into" ;;
            d:*)     cur="$cur/${choice#d:}" ;;
            f:*)     download "$cur/${choice#f:}" "$into" ;;
        esac
    done
}

download() { # DRIVE_PATH LOCAL_DIR - never overwrites; a clash gets a new name
    say "Downloading $1 to $2"
    if timeout "$SEND_TIMEOUT" proton-drive filesystem download -f rename -d rename "$1" "$2" \
        </dev/null >/dev/null 2>&1 && [[ -e $2/${1##*/} ]]; then
        notify normal "Downloaded from Proton Drive" "${1##*/} to $2"
        exit 0
    fi
    notify critical "Download failed" "${1##*/} did not arrive in $2"
    ui_error "${1##*/} did not arrive in $2."
    exit 1
}

# --- main --------------------------------------------------------------------

FILES=("$@")
[[ $MODE == refresh ]] && exec "$HERE/pd-send-menu"
if ! drive_ready; then
    notify critical "Proton Drive not reachable" "Run pd-session in a terminal to log in again."
    ui_error "Proton Drive is not reachable. Run pd-session in a terminal."
    exit 1
fi

case $MODE in
    get)   get "${FILES[0]}" ;;
    send)  (( ${#FILES[@]} )) || die "no files given"; send ;;
    pick)  (( ${#FILES[@]} )) || die "no files given"; pick_folder; send ;;
    mkdir) (( ${#FILES[@]} )) || die "no files given"
           [[ -n $DEST ]] || pick_folder "Make the new folder in:"
           make_folder "$DEST" || exit 0
           DEST=$NEW; send ;;
esac
